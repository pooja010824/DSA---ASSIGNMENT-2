#include <stdio.h>

int main() {
    int arr[] = {7, 9, 12, 6, 8, 5, 4};
    int n = sizeof(arr) / sizeof(arr[0]);
    int target = 8;
    int i, found = 0;

    for(i = 0; i < n; i++) {
        if(arr[i] == target) {
            printf("Element %d found at index %d.\n", target, i);
            found = 1;
            break;
        }
    }

    if(!found)
        printf("Element %d not found in the array.\n", target);

    return 0;
}
